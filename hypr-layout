#!/usr/bin/env python3
"""hypr-layout — snapshot and replay the Hyprland window layout.

Reopening a work setup by hand is: launch app, launch app, launch app, then
drag them where they go. Tiling order IS the layout, so replaying the same apps
into the same workspaces rebuilds it.

How the replay works (and why it is not flaky):

  * apps are launched **in parallel** — no per-window sleeping;
  * every window is placed by its **address**, the moment Hyprland announces
    it on the event socket — never by guessing from a window rule, which
    silently fails for apps that hand off to an already-running instance;
  * anything that acts on "the active window" (grouping) is preceded by a
    **verified focus**, because Hyprland happily applies those to whatever
    happens to be focused if the focus silently fails;
  * the **arrangement** — which window is left, top or bottom — is rebuilt
    from the rectangles the save recorded, by re-inserting the tiles in tree
    order (`layout preselect` + move), because a dwindle tree cannot be set
    directly but can be built;
  * the result is read back and reported per entry;
  * **animations are switched off for the replay** and put back afterwards — a
    replay is a burst of window moves, and animating all of it reads as a
    strobe instead of a layout coming back.

  hypr-layout save               snapshot what is on screen right now -> layout.json
  hypr-layout save --name work   keep it as a named layout
  hypr-layout restore            relaunch everything from the snapshot
  hypr-layout restore --pick     choose the layout (and workspace) from a menu
  hypr-layout layouts            list what is saved
  hypr-layout show               print the saved snapshot

Named layouts live in ~/.config/hypr/layouts/, so a keybinding can offer a
choice instead of being wired to one file:

  hypr-layout restore --pick             menu: which workspace (and which layout,
                                         when more than one is saved)
  hypr-layout save --pick                menu: name this layout
  hypr-layout restore --name work        straight to a named layout
  hypr-layout restore --history          back to one of the last few saves
  hypr-layout spill                      send the focused window to ws5

`restore --spill WS` first moves any window on the layout's workspaces that is
not part of it to WS: a stray window is a tile the saved tree knows nothing
about, and it splits the arrangement.

Every save keeps the few before it in ~/.config/hypr/layout-history/, so a save
taken at a bad moment does not cost you the good one.

The menu is whatever the desktop provides — `omarchy-menu-select` on Omarchy,
then wofi, rofi, fuzzel, dmenu.

Restore can be pointed at other workspaces without touching the snapshot:

  hypr-layout restore --workspace 3                  every window on workspace 3
  hypr-layout restore --workspace-map 'firefox=2'    per-class override
  hypr-layout restore --workspace 3 --workspace-map 'obs=4'
                                                     base workspace, class wins

Edit layout.json by hand if you want a different tiling order — it is a plain
list, and restore plays it top to bottom.
"""
import argparse
import json
import os
import queue
import select
import shlex
import shutil
import socket
import subprocess
import sys
import threading
import time
from collections import defaultdict

LAYOUT = os.path.expanduser("~/.config/hypr/layout.json")
LAYOUT_DIR = os.path.expanduser("~/.config/hypr/layouts")
LAYOUT_HISTORY = os.path.expanduser("~/.config/hypr/layout-history")
HISTORY_KEEP = 5          # earlier saves kept per layout
WORKSPACE_RANGE = 10      # numeric workspaces offered (Hyprland has no fixed count)
SPILL_WORKSPACE = 5       # where `--spill` and `spill` park windows by default
HOME = os.path.expanduser("~")
# Never replayed: transient or WM-internal surfaces.
SKIP_CLASSES = {"hyprland", "xwaylandvideobridge"}


# ── Hyprland connection ──────────────────────────────────────────────────────
# One unix socket for commands (~0.1 ms) instead of spawning hyprctl (~15 ms
# each). This is what makes a replay fast enough to feel instant.

def instance_dir():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = f"/run/user/{os.getuid()}/hypr"
    if sig and os.path.exists(f"{runtime}/{sig}/.socket.sock"):
        return f"{runtime}/{sig}"
    for name in sorted(os.listdir(runtime)) if os.path.isdir(runtime) else []:
        if os.path.exists(f"{runtime}/{name}/.socket.sock"):
            return f"{runtime}/{name}"
    sys.exit("hypr-layout: no running Hyprland instance found")


SOCKET_DIR = None


def sock_command(command, timeout=5.0):
    """Send one command to the compositor and return its reply."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(f"{SOCKET_DIR}/.socket.sock")
        s.sendall(command.encode())
        s.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            try:
                chunk = s.recv(1 << 20)
            except socket.timeout:
                break
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks).decode()
    finally:
        s.close()


def dispatch(lua):
    """Hyprland 0.56 on Omarchy parses `dispatch` as Lua."""
    reply = sock_command(f"dispatch {lua}").strip()
    if reply.startswith("error") or "invalid" in reply.lower():
        return reply
    return reply


def clients():
    return json.loads(sock_command("j/clients"))


def by_address(addr):
    return next((c for c in clients() if c.get("address") == addr), None)


def active_address():
    return json.loads(sock_command("j/activewindow")).get("address")


class Events:
    """Live stream of compositor events (openwindow, closewindow, …)."""

    def __init__(self):
        self.queue = queue.Queue()
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(f"{SOCKET_DIR}/.socket2.sock")
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        buf = b""
        while True:
            try:
                chunk = self.sock.recv(65536)
            except OSError:
                return
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                name, _, data = line.decode(errors="replace").partition(">>")
                self.queue.put((name, data))

    def next(self, deadline, want=("openwindow",)):
        """Wait for an event of interest; returns (name, data) or None."""
        while True:
            left = deadline - time.time()
            if left <= 0:
                return None
            try:
                name, data = self.queue.get(timeout=min(left, 0.25))
            except queue.Empty:
                continue
            if name in want:
                return name, data

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def auto_group():
    return "true" in sock_command("getoption group:auto_group")


def set_auto_group(enabled):
    """Hyprland 0.56 here uses a Lua config parser: `keyword` is refused and
    the option has to be set through `eval`."""
    value = "true" if enabled else "false"
    reply = sock_command(f'eval hl.config({{ group = {{ auto_group = {value} }} }})').strip()
    if reply and reply != "ok":
        print(f"  warning: could not set group:auto_group — {reply[:80]}")


def animations_enabled():
    return "true" in sock_command("getoption animations:enabled")


def set_animations(enabled):
    """A replay moves windows in bursts — parked, re-inserted, resized. With
    animations on that reads as a strobe; with them off the layout simply
    appears. The previous value is put back when the replay ends."""
    value = "true" if enabled else "false"
    reply = sock_command(f'eval hl.config({{ animations = {{ enabled = {value} }} }})').strip()
    if reply and reply != "ok":
        print(f"  warning: could not set animations:enabled — {reply[:80]}")


def focus_checked(address, tries=4):
    """Focus a window and confirm it actually got the focus.

    Grouping dispatchers act on "the active window". A focus that silently
    fails means the next dispatch hits an unrelated window — which is how a
    replay can scramble a layout instead of rebuilding it.
    """
    for _ in range(tries):
        if by_address(address) is None:
            return False
        # Focusing by address crosses workspaces on its own, so no workspace
        # switch is needed — good, because `hl.dsp.workspace` is not dependable
        # (on this build it is a table and errors out, while the same call
        # worked earlier in the same session). The focus is read back below.
        dispatch(f'hl.dsp.focus({{ window = "address:{address}" }})')
        if active_address() == address:
            return True
        time.sleep(0.05)
    return False


def load_layout(path):
    """Read a snapshot, or explain what to do instead of raising."""
    try:
        with open(path) as fh:
            layout = json.load(fh)
    except FileNotFoundError:
        sys.exit(f"hypr-layout: nothing saved at {path}\n"
                 f"             run `hypr-layout save` to snapshot your current session")
    except json.JSONDecodeError as exc:
        sys.exit(f"hypr-layout: {path} is not valid JSON — {exc}")
    if not layout.get("entries"):
        sys.exit(f"hypr-layout: {path} has no windows in it\n"
                 f"             run `hypr-layout save` while your session is open")
    return layout


# ── the layout library, and asking through the desktop's own menu ─────────────
# `--name work` keeps a layout in ~/.config/hypr/layouts/, so a restore can ask
# which one instead of being wired to a single file. The asking is done by the
# desktop's menu rather than a UI of our own: on Omarchy that is
# `omarchy-menu-select`, the same picker its system menus use.

def safe_name(name):
    """A layout name becomes a filename, so it gets filtered down to one."""
    clean = "".join(ch for ch in (name or "").strip() if ch.isalnum() or ch in "._ -")
    clean = os.path.basename(clean).strip()
    if not clean or clean.startswith("."):
        sys.exit(f"hypr-layout: {name!r} is not a usable layout name")
    return clean


def named_path(name):
    return os.path.join(LAYOUT_DIR, safe_name(name) + ".json")


def all_layouts():
    """(name, path, snapshot) for every saved layout, most recent first."""
    found = [("default", LAYOUT)] if os.path.exists(LAYOUT) else []
    if os.path.isdir(LAYOUT_DIR):
        found += [(fn[:-5], os.path.join(LAYOUT_DIR, fn))
                  for fn in sorted(os.listdir(LAYOUT_DIR)) if fn.endswith(".json")]
    loaded = []
    for name, path in found:
        try:
            with open(path) as fh:
                loaded.append((name, path, json.load(fh)))
        except (OSError, json.JSONDecodeError):
            continue          # a half-written file should not break the picker
    loaded.sort(key=lambda item: item[2].get("saved_at", ""), reverse=True)
    return loaded


def menu_pick(prompt, options, width=460, icon="󱂬"):
    """One option from the desktop's menu. Returns the label, '' if cancelled.

    An option may be a (label, subtext) pair; subtext is only shown by menus
    that can render one (omarchy-menu-select does, the others ignore it).

    Two things about how this menu renders, learned the hard way: a row needs a
    leading glyph, or the label is drawn clipped, and the panel does not grow to
    fit — a long prompt or subtext is cut off with an ellipsis instead. The
    glyph is drawn but never returned, so the label still comes back alone.
    """
    rows = [(o, None) if isinstance(o, str) else tuple(o) for o in options]
    for prog, extra in (("omarchy-menu-select", None),
                        ("wofi", ["--dmenu", "--prompt", prompt]),
                        ("rofi", ["-dmenu", "-p", prompt]),
                        ("fuzzel", ["--dmenu", "--prompt", prompt]),
                        ("dmenu", ["-p", prompt])):
        if not shutil.which(prog):
            continue
        if extra is None:     # options as arguments, selected label on stdout
            argv = [prog, prompt] + ["\t".join([icon, label] + ([sub] if sub else []))
                                     for label, sub in rows]
            argv += ["--", "--width", str(width)]
            stdin = None
        else:                 # options on stdin, as every dmenu clone expects
            argv = [prog] + extra
            stdin = "\n".join(label for label, _ in rows)
        result = subprocess.run(argv, input=stdin, capture_output=True, text=True)
        if result.returncode != 0:
            return ""         # every one of these exits non-zero on ESC
        # A subtext comes back appended after a tab; the label is the key.
        return result.stdout.strip().split("\n")[0].split("\t")[0].strip()
    sys.exit("hypr-layout: no menu to ask (tried omarchy-menu-select, wofi, rofi, "
             "fuzzel, dmenu) — pass --name or --workspace instead")


def stem_of(path):
    """The file's bare name without .json — how a layout is recognised."""
    return os.path.basename(path)[:-5] if path.endswith(".json") else os.path.basename(path)


def keep_history(path, keep=HISTORY_KEEP):
    """Rotate the save that is about to be overwritten into a history folder.

    A save taken at a bad moment would otherwise be the only copy. The last few
    are kept per layout, pruned so this cannot grow without bound, and
    `restore --history` lists them.
    """
    if not os.path.exists(path):
        return
    os.makedirs(LAYOUT_HISTORY, exist_ok=True)
    stem = stem_of(path)
    dest = os.path.join(LAYOUT_HISTORY, f"{stem}-{time.strftime('%Y%m%d-%H%M%S')}.json")
    if os.path.exists(dest):
        return                                    # two saves within one second
    shutil.copy2(path, dest)
    olds = sorted(f for f in os.listdir(LAYOUT_HISTORY) if f.startswith(f"{stem}-"))
    for name in olds[:-keep]:
        os.remove(os.path.join(LAYOUT_HISTORY, name))


def history_files(path):
    """Earlier saves of one layout, newest first."""
    if not os.path.isdir(LAYOUT_HISTORY):
        return []
    stem = stem_of(path)
    return [os.path.join(LAYOUT_HISTORY, f)
            for f in sorted((f for f in os.listdir(LAYOUT_HISTORY)
                             if f.startswith(f"{stem}-") and f.endswith(".json")),
                            reverse=True)]


def history_label(name):
    """'20260912-102409' -> '12 Sep 10:24:09'."""
    try:
        return time.strftime("%d %b %H:%M:%S", time.strptime(name, "%Y%m%d-%H%M%S"))
    except ValueError:
        return name


def pick_history(path):
    """Choose one of the earlier saves of this layout."""
    files = history_files(path)
    if not files:
        sys.exit(f"hypr-layout: no earlier saves of {stem_of(path)} to go back to")
    rows, by_label = [], {}
    for f in files:
        stamp = os.path.basename(f)[len(stem_of(path)) + 1:-5]
        label = history_label(stamp)          # the file's stamp is the key
        try:
            with open(f) as fh:
                n = len(json.load(fh).get("entries", []))
        except (OSError, json.JSONDecodeError):
            n = 0
        rows.append((label, f"{n} windows"))
        by_label[label] = f
    choice = menu_pick(f"Go back to which save of “{stem_of(path)}”?", rows)
    if not choice:
        sys.exit("hypr-layout: cancelled")
    if choice in by_label:
        return by_label[choice]
    sys.exit(f"hypr-layout: no save labelled {choice!r}")


def ws_sort_key(ws):
    ws = str(ws)
    return (not ws.isdigit(), int(ws) if ws.isdigit() else ws)


def pick_layout():
    """Which saved layout? Returns (name, path).

    With only one layout saved the question answers itself, so it is skipped —
    the workspace question that follows now explains its own rows. With two or
    more, it is always asked: that is what --pick is for.
    """
    saved = all_layouts()
    if not saved:
        sys.exit("hypr-layout: nothing saved yet — run `hypr-layout save` first")
    if len(saved) == 1:
        name, path, _ = saved[0]
        return name, path
    rows = []
    for name, path, layout in saved:
        n = len(layout.get("entries", []))
        when = (layout.get("saved_at") or "?")[5:16]      # "09-12 09:49"
        rows.append((name, f"{n} windows · {when}"))
    choice = menu_pick("Restore which layout?", rows)
    if not choice:
        sys.exit("hypr-layout: cancelled")
    for name, path, _ in saved:
        if name == choice:
            return name, path
    sys.exit(f"hypr-layout: no layout named {choice!r}")


def pick_workspace(layout, label):
    """Which workspace? 'keep as saved' keeps the workspaces the layout recorded.

    The numeric list is the full range you can key to, not just the workspaces
    that happen to exist: Hyprland creates a workspace the moment a window is
    moved to it, so a number that does not exist yet is still a valid answer.
    """
    saved = {str(e["workspace"]) for e in layout["entries"]}
    live = {workspace_of(c) for c in clients()}
    spaces = {str(n) for n in range(1, WORKSPACE_RANGE + 1)} | saved | live
    rows = [("keep as saved", "everything back on its own workspace")]
    for ws in sorted(spaces, key=ws_sort_key):
        here = " (has windows)" if ws in live else ""
        rows.append((ws, f"move everything to ws{ws}{here}"))
    choice = menu_pick("Where should it go?", rows)
    if not choice:
        sys.exit("hypr-layout: cancelled")
    return choice


def ask_name():
    """Prompt for a layout name through the desktop's menu."""
    if shutil.which("omarchy-menu-input"):
        result = subprocess.run(["omarchy-menu-input", "Save this layout as…"],
                                capture_output=True, text=True)
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
        sys.exit("hypr-layout: cancelled")
    sys.exit("hypr-layout: no input menu available — pass --name instead")


# ── capture ──────────────────────────────────────────────────────────────────

def split_command(cmd):
    """Turn a snapshot's command into an argv, tolerating one saved as a line.

    Chromium and Electron rewrite their own /proc/<pid>/cmdline and collapse
    the NUL separators, so a command captured from one is a single string
    holding the whole command line. Executing that as a path fails with ENOENT
    — and when the replay runs from a keybinding there is no terminal to say
    so, which is exactly how a window goes quietly missing.
    """
    if len(cmd) == 1 and " " in cmd[0].strip():
        try:
            return shlex.split(cmd[0])
        except ValueError:
            return cmd
    return cmd


def warn(message):
    """Report a problem, and say it out loud when nobody is watching.

    A replay from a keybinding or a menu has no terminal attached, so stdout
    goes nowhere. If stdout is not a tty, the message also goes to the desktop
    notification daemon.
    """
    print(f"  warning: {message}")
    if sys.stdout.isatty() or not shutil.which("notify-send"):
        return
    subprocess.run(["notify-send", "-a", "hypr-layout", "-t", "8000",
                    "hypr-layout", message], capture_output=True)


def client_cmd(pid):
    """Best-effort relaunch command for a window, from its process."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            argv = [a.decode() for a in fh.read().split(b"\0") if a]
    except OSError:
        argv = []
    if not argv:
        try:
            argv = [os.readlink(f"/proc/{pid}/exe")]
        except OSError:
            return None, None
    try:
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        cwd = None
    return split_command(argv), cwd


def workspace_of(client):
    ws = client.get("workspace") or {}
    return ws.get("name") or str(ws.get("id", 1))


def group_of(client):
    """(group key, tab index, is visible tab) — key is None when ungrouped."""
    members = client.get("grouped") or []
    if not members:
        return None, 0, False
    addr = client.get("address")
    return members[0], members.index(addr) if addr in members else 0, bool(client.get("visible"))


def sanitize(cls, argv, cwd, title=""):
    """Fix up argv that only made sense in the session it was captured from."""
    # Zed hands its launcher a one-shot IPC socket that is gone by replay time.
    argv = [a for a in argv if not a.startswith("zed-cli://")]
    # Nautilus in service mode registers a daemon instead of opening a window;
    # its window title is the folder it was showing.
    if cls.endswith("Nautilus"):
        target = title if title and os.path.isdir(os.path.expanduser(title)) else cwd
        return ["nautilus"] + ([target] if target and target != HOME else [])
    return argv


def cmd_save(args):
    if getattr(args, "pick", False):
        args.file = named_path(ask_name())
    layout_monitors = json.loads(sock_command("j/monitors"))
    entries, skipped = [], []
    for c in clients():
        cls = c.get("class") or c.get("initialClass") or "?"
        if cls in SKIP_CLASSES:
            skipped.append(f"{cls}: internal")
            continue
        if c.get("floating") and not args.floating:
            skipped.append(f"{cls}: floating")
            continue
        if c.get("hidden"):
            skipped.append(f"{cls}: hidden")
            continue
        argv, cwd = client_cmd(c.get("pid", 0))
        if not argv:
            skipped.append(f"{cls}: no cmdline")
            continue
        gkey, gindex, gactive = group_of(c)
        entries.append({
            "class": cls,
            "title": (c.get("title") or "")[:80],
            "workspace": workspace_of(c),
            "floating": bool(c.get("floating")),
            "at": c.get("at"),
            "size": c.get("size"),
            "cmd": sanitize(cls, argv, cwd, c.get("title") or ""),
            "cwd": cwd,
            "group": gkey,
            "group_index": gindex,
            "group_active": gactive,
        })

    layout = {
        "saved_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "monitors": [{"name": m["name"], "mode": f"{m['width']}x{m['height']}@"
                      f"{round(m['refreshRate'])}", "scale": m.get("scale", 1)}
                     for m in layout_monitors],
        "entries": entries,
    }
    os.makedirs(os.path.dirname(args.file), exist_ok=True)
    keep_history(args.file)           # the save about to be replaced, kept aside
    with open(args.file, "w") as fh:
        json.dump(layout, fh, indent=2)
    print(f"saved {len(entries)} windows -> {args.file}")
    for e in entries:
        tab = f" [group tab {e['group_index'] + 1}{'*' if e['group_active'] else ''}]" \
            if e["group"] else ""
        print(f"  ws{e['workspace']:<8} {e['class']:<18} {e['title'][:44]}{tab}")
    groups = {e["group"] for e in entries if e["group"]}
    if groups:
        print(f"  ({len(groups)} window group(s) captured — '*' marks the visible tab)")
    for s in skipped:
        print(f"  skipped  {s}")
    print("\nedit the entries list to change tiling order; restore replays top to bottom.")
    hist = len(history_files(args.file))
    if hist:
        print(f"{hist} earlier save{'s' if hist != 1 else ''} kept in {LAYOUT_HISTORY} "
              f"(restore --history goes back)")


def cmd_show(args):
    layout = load_layout(args.file)
    print(f"{args.file}  (saved {layout['saved_at']})")
    for e in layout["entries"]:
        tab = f" [tab {e['group_index'] + 1}{'*' if e.get('group_active') else ''}]" \
            if e.get("group") else ""
        print(f"  ws{e['workspace']:<8} {e['class']:<18} {e['title'][:44]}{tab}")


# ── replay ───────────────────────────────────────────────────────────────────

def spill_strays(entries, addresses, target):
    """Move windows on the layout's workspaces that are not part of it away.

    Anything else on those workspaces is a tile the tree does not know about,
    and it splits the arrangement — a fifth tile in a 2x2 halves everything.
    Returns how many were moved.
    """
    known = {a for a in addresses.values() if a}
    spaces = {str(e["workspace"]) for e in entries}
    strays = [c for c in clients()
              if workspace_of(c) in spaces and c["address"] not in known]
    for c in strays:
        address = c["address"]
        # A stray that has become a tab in one of the layout's tiles has to
        # leave that group first — moving one member of a group takes the
        # group with it, so it would either drag layout windows along or be
        # dragged straight back by the arrangement.
        if c.get("grouped") and focus_checked(address):
            dispatch("hl.dsp.window.move({ out_of_group = true })")
            time.sleep(0.1)
        dispatch(f'hl.dsp.window.move({{ workspace = "{target}", follow = false, '
                 f'window = "address:{address}" }})')
    return strays


def dissolve_solo_groups(entries, addresses):
    """Break up any group holding a single window.

    A group of one is not a group, but it still draws a tab bar — so the window
    sits 28 px down from where it was saved and reports as "unexpectedly
    grouped". Pulling a stray out of one of the layout's tiles leaves exactly
    that behind.
    """
    for i, _e in enumerate(entries):
        address = addresses.get(i)
        client = by_address(address) if address else None
        if not (client and client.get("grouped")):
            continue
        gid = client["grouped"][0]
        members = [c for c in clients()
                   if c.get("grouped") and c["grouped"][0] == gid]
        if len(members) > 1:
            continue
        if focus_checked(address):
            dispatch("hl.dsp.window.move({ out_of_group = true })")
            time.sleep(0.08)


def cmd_spill(args):
    """Send one window to another workspace, to keep a layout clear of strays."""
    workspace = str(args.workspace or SPILL_WORKSPACE)
    address = active_address()
    client = by_address(address) if address else None
    if client is None:
        sys.exit("hypr-layout: no active window to move")
    dispatch(f'hl.dsp.window.move({{ workspace = "{workspace}", follow = false, '
             f'window = "address:{address}" }})')
    print(f"moved {client['class']} to ws{workspace}")


def cmd_layouts(args):
    saved = all_layouts()
    if not saved:
        print("no layouts saved yet — run `hypr-layout save`")
        return
    any_history = False
    for name, path, layout in saved:
        n = len(layout.get("entries", []))
        hist = len(history_files(path))
        any_history = any_history or bool(hist)
        extra = f"   {hist} earlier save{'s' if hist != 1 else ''}" if hist else ""
        default = "   (the default)" if path == LAYOUT else ""
        print(f"  {name:<20} {n:>2} window{'s' if n != 1 else ''}   "
              f"saved {layout.get('saved_at', '?')}{default}{extra}")
    if any_history:
        print(f"\nearlier saves live in {LAYOUT_HISTORY}; "
              "`hypr-layout restore --history` goes back to one")


def order_for_launch(entries):
    """Keep a group's members back to back, so they are merged in one run."""
    out, done = [], set()
    for e in entries:
        g = e.get("group")
        if not g:
            out.append(e)
        elif g not in done:
            done.add(g)
            out.extend(x for x in entries if x.get("group") == g)
    return out


def parse_workspace_map(spec):
    """'firefox=2,obs:3' or 'firefox=2,obs=3' -> {'firefox': '2', 'obs': '3'}."""
    mapping = {}
    for pair in spec.split(","):
        pair = pair.strip()
        if not pair:
            continue
        for sep in ("=", ":"):
            if sep in pair:
                cls, _, ws = pair.partition(sep)
                break
        else:
            sys.exit(f"--workspace-map: '{pair}' is not 'class=workspace'")
        cls, ws = cls.strip(), ws.strip()
        if not cls or not ws:
            sys.exit(f"--workspace-map: '{pair}' is not 'class=workspace'")
        mapping[cls] = ws
    return mapping


def apply_workspace_overrides(entries, global_ws, mapping):
    """Move entries to the requested workspaces before anything is launched.

    `--workspace` sets the base for every window, then `--workspace-map`
    overrides per class.
    """
    for e in entries:
        if global_ws:
            e["workspace"] = global_ws
        wanted = mapping.get(e["class"])
        if wanted is None:  # tolerate case differences in the class name
            wanted = next((ws for cls, ws in mapping.items()
                           if cls.lower() == e["class"].lower()), None)
        if wanted:
            e["workspace"] = wanted

    unknown = [cls for cls in mapping
               if not any(cls.lower() == e["class"].lower() for e in entries)]
    for cls in unknown:
        print(f"  warning: --workspace-map has '{cls}', no such window in the layout")

    # A group only exists inside one workspace, so a split group cannot be built.
    for gid in {e["group"] for e in entries if e.get("group")}:
        members = [e for e in entries if e.get("group") == gid]
        spaces = {e["workspace"] for e in members}
        if len(spaces) > 1:
            names = ", ".join(f"{e['class']}→ws{e['workspace']}" for e in members)
            print(f"  warning: group split across workspaces ({names}) — "
                  "those windows will not be grouped")
            for e in members:
                e["group"] = None


def existing_pool(force):
    """Class -> open windows, for launch-or-focus reuse.

    Reuse is a judgement call: several windows share a class (every terminal is
    `foot`), and grabbing the wrong one drags an unrelated window across the
    layout. Candidates are scored on title, workspace and group membership
    instead of taking whichever one happens to be first.
    """
    pool = defaultdict(list)
    if not force:
        for c in clients():
            pool[(c.get("class") or "?")].append(c)
    return pool


def rect_distance(client, entry):
    """How far a live window is from where this entry wants it, squared.

    Used only to break ties (see take_existing). Windows of the same class are
    not always distinguishable — two Firefox windows share a class, and their
    titles change as pages navigate — so when the score cannot tell them apart,
    the one already nearest its target is the safer pick: a restore then leaves
    a window where it is instead of swapping two of them for no reason.
    """
    want = saved_rect(entry)
    if not want:
        return float("inf")
    have = rect_of(client)
    return (have[0] - want[0]) ** 2 + (have[1] - want[1]) ** 2


def title_score(entry, client):
    """How much a live title looks like the one the save recorded."""
    title = (entry.get("title") or "").strip()
    live = (client.get("title") or "").strip()
    if not title:
        return 0
    if live == title:
        return 4
    return 2 if live[:12] == title[:12] else 0


def context_score(entry, client):
    """Same workspace, and grouped or not, as the entry expects."""
    return (2 if workspace_of(client) == str(entry["workspace"]) else 0) + \
           (1 if bool(client.get("grouped")) == bool(entry.get("group")) else 0)


def match_existing(pool, entries):
    """Which open window fills which entry: {entry index -> address}.

    Asking entries one at a time is not enough. Two windows can share a class
    and be indistinguishable by anything durable — two Firefox windows drift
    apart in title as pages navigate — so whichever entry is asked first takes
    the window that a later entry matches by name, and the two trade places.
    So every (entry, window) pair is scored up front and the most confident
    pairs are claimed first. A tie goes to the window already nearest where
    that entry wants it, so a restore does not move a window for nothing.
    """
    pairs = []
    for i, e in enumerate(entries):
        for c in pool.get(e["class"], []):
            pairs.append((title_score(e, c) + context_score(e, c),
                          rect_distance(c, e), i, c["address"]))
    pairs.sort(key=lambda p: (-p[0], p[1]))
    chosen, taken_entries, taken = {}, set(), set()
    for _points, _dist, i, address in pairs:
        if i in taken_entries or address in taken:
            continue
        taken_entries.add(i)
        taken.add(address)
        chosen[i] = address
    return chosen


def spawn(entry):
    """Start the app, detached from this process."""
    argv = split_command(entry["cmd"])
    cwd = entry.get("cwd")
    if cwd and cwd != HOME and not os.path.isdir(cwd):
        cwd = None
    try:
        return subprocess.Popen(
            argv, cwd=cwd, start_new_session=True,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, env=os.environ.copy())
    except OSError as exc:
        warn(f"could not launch {argv[0]}: {exc}")
        return None


def place(entry, address):
    """Put a window on its workspace (and float/resize it if the save says so)."""
    client = by_address(address)
    if client is None:
        return False
    if workspace_of(client) != str(entry["workspace"]):
        dispatch(f'hl.dsp.window.move({{ workspace = "{entry["workspace"]}", '
                 f'follow = false, window = "address:{address}" }})')
    if entry.get("floating"):
        dispatch(f'hl.dsp.window.float({{ action = "enable", '
                 f'window = "address:{address}" }})')
        size, at = entry.get("size"), entry.get("at")
        if size:
            dispatch(f'hl.dsp.window.resize({{ x = {int(size[0])}, y = {int(size[1])}, '
                     f'window = "address:{address}" }})')
        if at:
            dispatch(f'hl.dsp.window.move({{ x = {int(at[0])}, y = {int(at[1])}, '
                     f'window = "address:{address}" }})')
    elif client.get("floating"):
        # A window that drifted into floating is invisible to the tiling tree,
        # so every preselect insert built on top of it silently does nothing
        # and the arrangement comes out as strips. Put it back in the tiling.
        dispatch(f'hl.dsp.window.float({{ action = "disable", '
                 f'window = "address:{address}" }})')
    return workspace_of(by_address(address) or {}) == str(entry["workspace"])


def launch_all(entries, stagger):
    """Launch every entry that has no window yet; return address per entry.

    Apps start in parallel and windows are picked up from the event stream as
    Hyprland announces them, so the whole replay takes about as long as the
    slowest app needs to open.
    """
    events = Events()
    pending = {}           # pid -> entry index
    pids = {}
    for i, e in enumerate(entries):
        proc = spawn(e)
        if proc:
            pids[i] = proc.pid
            pending[proc.pid] = i
        if stagger:
            time.sleep(stagger)

    addresses = {}
    unclaimed = set(range(len(entries)))   # entry indexes still waiting
    by_class = defaultdict(list)           # class -> waiting entry indexes
    for i in unclaimed:
        by_class[entries[i]["class"]].append(i)

    deadline = time.time() + max(20.0, 10.0 + 3.0 * len(entries))
    while unclaimed and time.time() < deadline:
        event = events.next(deadline)
        if event is None:
            break
        _, data = event
        fields = data.split(",")
        if len(fields) < 3:
            continue
        address, cls = fields[0], fields[2]
        address = address if address.startswith("0x") else f"0x{address}"
        client = by_address(address)
        if client is None:
            continue

        # Match the window to the entry that produced it, best evidence first:
        # the process we started, then the class we asked for, then — if a
        # single entry is still waiting — the only window that opened after we
        # launched it (apps like Firefox hand the window to another process).
        idx = pending.get(client.get("pid"))
        if idx is not None and idx not in unclaimed:
            idx = None
        if idx is None:
            waiting = [j for j in by_class.get(cls, []) if j in unclaimed]
            idx = waiting[0] if waiting else None
        if idx is None and len(unclaimed) == 1:
            idx = next(iter(unclaimed))
        if idx is None:
            continue      # not ours — leave it alone

        unclaimed.discard(idx)
        for lst in by_class.values():
            if idx in lst:
                lst.remove(idx)
        place(entries[idx], address)
        addresses[idx] = address
    events.close()
    return addresses


def group_matches(entries, addresses):
    """True when these windows already form the saved group, tab for tab."""
    live = [by_address(a) for a in addresses if a]
    if len(live) != len(entries) or any(c is None for c in live):
        return False
    keys = {(c.get("grouped") or [None])[0] for c in live}
    if len(keys) != 1 or None in keys:
        return False
    for e, c in zip(entries, live):
        _, index, visible = group_of(c)
        if index != e["group_index"] or visible != bool(e.get("group_active")):
            return False
    return True


def build_group(entries, addresses):
    """Form one window group from windows that are already placed."""
    members = [(e, a) for e, a in zip(entries, addresses) if a and by_address(a)]
    if len(members) < 2:
        return
    anchor = members[0][1]
    if not focus_checked(anchor):
        print(f"  FAIL group: cannot focus {entries[0]['class']}")
        return
    if (by_address(anchor) or {}).get("grouped"):
        dispatch("hl.dsp.window.move({ out_of_group = true })")
        time.sleep(0.1)
    dispatch("hl.dsp.group.toggle()")

    for e, addr in members[1:]:
        merged = False
        if not focus_checked(addr):
            warn(f"cannot focus {e['class']} to group it")
            continue
        # A window that is grouped with something else has to leave that group
        # first, or it cannot be merged into this one.
        if (by_address(addr) or {}).get("grouped"):
            dispatch("hl.dsp.window.move({ out_of_group = true })")
            time.sleep(0.1)
        # Then make it a neighbour of the anchor, because `into_group` only
        # sees a group next door. Parking and re-inserting it against the
        # anchor with `preselect` is what guarantees that; trying the four
        # directions from wherever the window happens to be instead can grab a
        # *different* group that happens to be adjacent, which scrambles two
        # tiles at once.
        focus_checked(anchor)
        dispatch(f'hl.dsp.window.move({{ workspace = "{SCRATCH}", follow = false, '
                 f'window = "address:{addr}" }})')
        time.sleep(0.1)
        if focus_checked(anchor):
            dispatch('hl.dsp.layout("preselect r")')
        dispatch(f'hl.dsp.window.move({{ workspace = "{e["workspace"]}", '
                 f'follow = false, window = "address:{addr}" }})')
        time.sleep(0.2)
        if focus_checked(addr):
            for direction in ("l", "r", "u", "d"):
                dispatch(f'hl.dsp.window.move({{ into_group = "{direction}" }})')
                time.sleep(0.06)
                if anchor in ((by_address(addr) or {}).get("grouped") or []):
                    merged = True
                    break
        if not merged:
            warn(f"could not merge {e['class']} into the group")

    visible = next((a for e, a in members if e.get("group_active")), members[0][1])
    focus_checked(visible)
    ok = all(anchor in ((by_address(a) or {}).get("grouped") or []) for _, a in members[1:])
    label = ", ".join(e["class"] for e, _ in members)
    print(f"  {'OK  ' if ok else 'FAIL'} group of {len(members)}: {label}")


# ── arrangement ──────────────────────────────────────────────────────────────
# Workspace and group membership are not the layout. Which window sits left,
# top or bottom comes from the dwindle tree, and a tree cannot be set directly
# — but it can be built: with a window focused, `layout preselect <side>` makes
# the next window to arrive split that window's rect on that side. So a saved
# arrangement is rebuilt by re-inserting the tiles in tree order, deriving the
# tree from the rectangles the save recorded.

TOL = 6                      # px of slack when comparing rectangles
SCRATCH = "special:hypr-layout"


def saved_rect(entry):
    if not entry.get("at") or not entry.get("size"):
        return None
    return (entry["at"][0], entry["at"][1], entry["size"][0], entry["size"][1])


def rect_of(client):
    return (*client["at"], *client["size"])


def rect_close(a, b, tol=TOL):
    return all(abs(x - y) <= tol for x, y in zip(a, b))


def _bbox(rects):
    x0 = min(r[0] for r in rects)
    y0 = min(r[1] for r in rects)
    return (x0, y0, max(r[0] + r[2] for r in rects) - x0,
            max(r[1] + r[3] for r in rects) - y0)


def arrange_tree(indexed):
    """Recover the dwindle tree from rectangles that tile a box.

    A leaf is {"index": n}; a split is {"split", "ratio", "first", "second"}
    where `first` is the left/top child — the side the ratio counts from.
    Tiles are separated by gaps and borders, never flush, so a split is
    detected as "everything in this group ends before that group starts".
    """
    if len(indexed) == 1:
        return {"index": indexed[0][1]}
    for axis in ("v", "h"):
        start, extent = (0, 2) if axis == "v" else (1, 3)
        ordered = sorted(indexed, key=lambda it: it[0][start])
        for k in range(1, len(ordered)):
            head, tail = ordered[:k], ordered[k:]
            if max(r[start] + r[extent] for r, _ in head) > min(r[start] for r, _ in tail):
                continue                      # they overlap on this axis
            hb = _bbox([r for r, _ in head])
            tb = _bbox([r for r, _ in tail])
            if hb[extent] == 0 or tb[extent] == 0:
                continue
            ratio = hb[extent] / (hb[extent] + tb[extent])
            return {"split": axis, "ratio": ratio,
                    "first": arrange_tree(head), "second": arrange_tree(tail)}
    return {"index": indexed[0][1]}


def leftmost(node):
    while "index" not in node:
        node = node["first"]
    return node["index"]


def tiles_of(entries, addresses):
    """Entries collapsed into tiles — a window group tiles as a single unit."""
    out = []
    for i, e in enumerate(entries):
        if not addresses.get(i):
            continue
        key = e.get("group") or f"entry{i}"
        tile = next((t for t in out if t["key"] == key), None)
        if tile is None:
            tile = {"key": key, "indexes": [], "rect": saved_rect(e)}
            out.append(tile)
        tile["indexes"].append(i)
    return out


def tile_rep(tile, addresses):
    """Address standing for the tile: a group moves as one unit with it."""
    live = [c for c in (by_address(addresses[i]) for i in tile["indexes"] if addresses.get(i))
            if c]
    if not live:
        return None
    return next((c["address"] for c in live if c.get("visible")), live[0]["address"])


def move_tile(address, workspace):
    return dispatch(f'hl.dsp.window.move({{ workspace = "{workspace}", follow = false, '
                    f'window = "address:{address}" }})')


def arrange(entries, addresses, workspace):
    """Rebuild one workspace's tiling so the tiles land in their saved rects."""
    tiles = [t for t in tiles_of(entries, addresses) if t["rect"]]
    if len(tiles) < 2 or not all(tile_rep(t, addresses) for t in tiles):
        return
    tree = arrange_tree([(t["rect"], n) for n, t in enumerate(tiles)])

    # Park every tile off the workspace first: an empty workspace has no tree,
    # and the build below needs to start from nothing.
    for tile in tiles:
        move_tile(tile_rep(tile, addresses), SCRATCH)
        time.sleep(0.08)

    def insert(index, anchor, side):
        tile = tiles[index]
        if anchor is not None:
            if not focus_checked(anchor):     # preselect applies to the focused window
                return None
            dispatch(f'hl.dsp.layout("preselect {side}")')
        move_tile(tile_rep(tile, addresses), workspace)
        time.sleep(0.12)
        return tile_rep(tile, addresses)

    def expand(node, owner):
        if "index" in node:
            return
        side = "r" if node["split"] == "v" else "d"
        second_owner = insert(leftmost(node["second"]), owner, side)
        if second_owner and abs(node["ratio"] - 0.5) > 0.04 and focus_checked(owner):
            dispatch(f'hl.dsp.layout("splitratio {node["ratio"]:.3f}")')
            time.sleep(0.08)
        expand(node["first"], owner)
        if second_owner:
            expand(node["second"], second_owner)

    owner = insert(leftmost(tree), None, None)
    if owner:
        expand(tree, owner)

    # Never leave a window parked: anything that missed the workspace goes back.
    for tile in tiles:
        rep = tile_rep(tile, addresses)
        live = by_address(rep) if rep else None
        if live and workspace_of(live) != str(workspace):
            move_tile(rep, workspace)


def cmd_restore(args):
    picked = None
    if getattr(args, "pick", False):
        picked, args.file = pick_layout()
    if getattr(args, "history", False):
        args.file = pick_history(args.file)
    layout = load_layout(args.file)
    entries = layout["entries"]
    if args.except_:
        entries = [e for e in entries if e["class"] not in args.except_]

    if getattr(args, "pick", False):
        chosen = pick_workspace(layout, picked or args.file)
        if chosen != "keep as saved":
            args.workspace = chosen

    mapping = parse_workspace_map(args.workspace_map) if args.workspace_map else {}
    if args.workspace or mapping:
        apply_workspace_overrides(entries, str(args.workspace) if args.workspace else None,
                                  mapping)

    if args.dry_run:
        pool = existing_pool(args.force)
        plan = match_existing(pool, entries)
        reused = 0
        print(f"would replay {len(entries)} windows from {args.file}:")
        for i, e in enumerate(entries, 1):
            tab = f" [tab {e['group_index'] + 1}]" if e.get("group") else ""
            have = plan.get(i - 1)
            reused += 1 if have else 0
            note = "  (focus the open window)" if have else ""
            print(f"  {i:2}. ws{e['workspace']:<6} {e['class']:<18} "
                  f"{' '.join(e['cmd'])[:52]}{tab}{note}")
        if reused:
            print(f"\n{reused} of {len(entries)} would focus a window that is already "
                  "open; --force launches new copies instead")
        if any(e.get("group") for e in entries):
            print("window groups would be rebuilt after all apps are up")
        return

    entries = order_for_launch(entries)
    grouping = any(e.get("group") for e in entries) and not args.no_groups

    started = time.time()
    print(f"replaying {len(entries)} windows")
    was_auto = auto_group() if grouping else False
    if grouping and was_auto:
        # Otherwise apps launched while a grouped window has focus join that
        # group on their own and land in the wrong tab.
        set_auto_group(False)

    was_anim = animations_enabled()
    if was_anim:
        # A replay parks and re-inserts every tile, so with animations on you
        # watch the whole layout strobe its way back. With them off it looks
        # like the layout simply appears, which is the point.
        set_animations(False)

    try:
        # Snapshot what is already open so an entry can focus an existing window
        # instead of starting a second copy (the Omarchy launch-or-focus idiom).
        pool = existing_pool(args.force)
        plan = match_existing(pool, entries)

        addresses, reused_flags, to_launch = {}, set(), []
        for i, e in enumerate(entries):
            address = plan.get(i)
            if address:
                reused_flags.add(i)
                place(e, address)
                addresses[i] = address
                print(f"  {i + 1:2}. ws{e['workspace']:<6} {e['class']:<18} "
                      "(focused the window already open)")
            else:
                to_launch.append(i)

        if to_launch:
            launched = launch_all([entries[i] for i in to_launch], args.delay)
            for slot, i in enumerate(to_launch):
                addr = launched.get(slot)
                addresses[i] = addr
                e = entries[i]
                if addr:
                    print(f"  {i + 1:2}. ws{e['workspace']:<6} {e['class']:<18} "
                          f"{' '.join(e['cmd'])[:52]}")
                else:
                    warn(f"{e['class']} did not open a window")
        if args.spill:
            moved = spill_strays(entries, addresses, args.spill)
            if moved:
                print(f"  moved {len(moved)} window(s) not in this layout "
                      f"to ws{args.spill}")
        dissolve_solo_groups(entries, addresses)
        if grouping:
            for gid in dict.fromkeys(e.get("group") for e in entries if e.get("group")):
                idxs = [i for i, e in enumerate(entries) if e.get("group") == gid]
                idxs.sort(key=lambda i: entries[i]["group_index"])  # tab order
                group_entries = [entries[i] for i in idxs]
                group_addrs = [addresses.get(i) for i in idxs]
                # A group that already matches the save is left alone: tearing
                # a correct group down and rebuilding it only adds ways to fail.
                if group_matches(group_entries, group_addrs):
                    print(f"  OK   group of {len(idxs)}: "
                          f"{', '.join(e['class'] for e in group_entries)} (already correct)")
                else:
                    build_group(group_entries, group_addrs)
        if not args.no_arrange:
            for ws in dict.fromkeys(str(e["workspace"]) for e in entries):
                idxs = [i for i, e in enumerate(entries) if str(e["workspace"]) == ws]
                arrange([entries[i] for i in idxs],
                        {n: addresses.get(i) for n, i in enumerate(idxs)}, ws)

    finally:
        if grouping and was_auto:
            set_auto_group(True)
        if was_anim:
            set_animations(True)

    ok, total = report(entries, addresses)
    print(f"{ok}/{total} windows placed correctly  ({time.time() - started:.1f}s)")
    if ok < total:
        warn(f"{total - ok} of {total} windows could not be placed")
    if args.verify:
        verify(entries)


def report(entries, addresses):
    """Per-entry check of workspace / tiling / tab, straight from the compositor."""
    live = {c.get("address"): c for c in clients()}
    ok = 0
    for i, e in enumerate(entries, 1):
        c = live.get(addresses.get(i - 1))
        if c is None:
            print(f"  FAIL {i:2}. {e['class']:<18} no window")
            continue
        problems = []
        if workspace_of(c) != str(e["workspace"]):
            problems.append(f"on ws{workspace_of(c)}, wanted ws{e['workspace']}")
        if bool(c.get("floating")) != bool(e.get("floating")):
            problems.append("floating" if e.get("floating") else "tiled")
        gkey, gindex, gactive = group_of(c)
        if e.get("group"):
            if not gkey:
                problems.append("not in a group")
            else:
                if gindex != e["group_index"]:
                    problems.append(f"tab {gindex + 1}, wanted {e['group_index'] + 1}")
                if gactive != bool(e.get("group_active")):
                    problems.append("wrong tab showing" if not gactive else "should not show")
        elif gkey:
            problems.append("unexpectedly grouped")
        want_rect = saved_rect(e)
        if want_rect and not e.get("floating") and not rect_close(rect_of(c), want_rect):
            have = rect_of(c)
            problems.append(f"arrangement {have[0]},{have[1]} {have[2]}x{have[3]} "
                            f"wanted {want_rect[0]},{want_rect[1]} "
                            f"{want_rect[2]}x{want_rect[3]}")
        tab = f" [tab {gindex + 1}{'*' if gactive else ''}]" if gkey else ""
        if problems:
            print(f"  FAIL {i:2}. ws{e['workspace']:<6} {e['class']:<18}{tab} "
                  f"{'; '.join(problems)}")
        else:
            ok += 1
            print(f"  ok   {i:2}. ws{e['workspace']:<6} {e['class']:<18}{tab}")
    return ok, len(entries)


def verify(entries):
    """Diff the live window set against the snapshot by class + workspace."""
    from collections import Counter
    have = Counter((c.get("class") or "?", workspace_of(c)) for c in clients())
    want = Counter((e["class"], e["workspace"]) for e in entries)
    missing = want - have
    extra = have - want
    if not missing and not extra:
        print("snapshot matches the live session")
        return
    for (cls, ws), n in missing.items():
        print(f"  missing: {n}x {cls} on ws{ws}")
    for (cls, ws), n in extra.items():
        print(f"  extra:   {n}x {cls} on ws{ws}")


def main():
    global SOCKET_DIR
    ap = argparse.ArgumentParser(prog="hypr-layout", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-f", "--file", default=LAYOUT, help=f"layout file (default {LAYOUT})")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("save", help="snapshot the current layout")
    s.add_argument("--floating", action="store_true",
                   help="include floating windows (their size and position are saved)")
    s.add_argument("--name", help="save as a named layout in ~/.config/hypr/layouts/")
    s.add_argument("--pick", action="store_true",
                   help="ask for the name in a menu instead of typing it")
    s.set_defaults(func=cmd_save)

    r = sub.add_parser("restore", help="relaunch the saved layout")
    r.add_argument("--dry-run", action="store_true",
                   help="print what would happen, change nothing")
    r.add_argument("--delay", type=float, default=0.0,
                   help="seconds between app launches (default 0: all at once)")
    r.add_argument("--except", dest="except_", action="append", default=[],
                   help="class to skip, repeatable")
    r.add_argument("--workspace", help="open every window on this workspace, e.g. 3")
    r.add_argument("--workspace-map",
                   help="per-class workspace, e.g. 'firefox=2,obs=3'")
    r.add_argument("--no-groups", action="store_true",
                   help="launch apps but skip rebuilding window groups")
    r.add_argument("--force", action="store_true",
                   help="always launch, even when a window of that class is "
                        "already open (default: focus the existing one)")
    r.add_argument("--no-arrange", action="store_true",
                   help="keep the windows on the right workspaces but do not "
                        "rebuild the tiling arrangement they were saved in")
    r.add_argument("--no-verify", action="store_true",
                   help="skip the final snapshot comparison")
    r.add_argument("--name", help="restore a layout saved with `save --name`")
    r.add_argument("--pick", action="store_true",
                   help="choose the layout and workspace from a menu")
    r.add_argument("--history", action="store_true",
                   help="choose one of the last few saves of this layout instead")
    r.add_argument("--spill", metavar="WS",
                   help="move windows on this layout's workspaces that are not part "
                        "of it to WS first, so they cannot split the arrangement")
    r.set_defaults(func=cmd_restore, verify=True)

    sp = sub.add_parser("spill", help="send the focused window elsewhere")
    sp.add_argument("--workspace", help=f"workspace to send it to "
                                        f"(default {SPILL_WORKSPACE})")
    sp.set_defaults(func=cmd_spill)

    sh = sub.add_parser("show", help="print the saved layout")
    sh.set_defaults(func=cmd_show)

    lst = sub.add_parser("layouts", help="list saved layouts")
    lst.set_defaults(func=cmd_layouts)

    args = ap.parse_args()
    if getattr(args, "name", None):
        if args.file != LAYOUT:
            ap.error("use either --name or --file, not both")
        args.file = named_path(args.name)
    if getattr(args, "pick", False) and args.file != LAYOUT:
        ap.error("--pick chooses the layout itself — drop --name/--file")
    if getattr(args, "no_verify", False):
        args.verify = False
    SOCKET_DIR = instance_dir()
    args.func(args)


if __name__ == "__main__":
    main()
