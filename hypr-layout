# ── replay ───────────────────────────────────────────────────────────────────

def stray_windows(entries, addresses):
    """Windows on the layout's workspaces that are not part of it.

    Anything else there is a tile the tree knows nothing about, and it splits
    the arrangement — a fifth tile in a 2×2 halves everything.
    """
    known = {a for a in addresses.values() if a}
    spaces = {str(e["workspace"]) for e in entries}
    return [c for c in clients()
            if workspace_of(c) in spaces and c["address"] not in known]


def spill_strays(entries, addresses, target):
    """Move the strays away to another workspace."""
    strays = stray_windows(entries, addresses)
    log_line(f"    strays on the layout's workspaces: "
             f"{', '.join(c['class'] for c in strays) if strays else 'none'}")
    for c in strays:
        address = c["address"]
        # A stray that has become a tab in one of the layout's tiles has to
        # leave that group first — moving one member of a group takes the
        # group with it, so it would either drag layout windows along or be
        # dragged straight back by the arrangement.
        if c.get("grouped") and focus_checked(address):
            dispatch("hl.dsp.window.move({ out_of_group = true })")
            time.sleep(0.1)
        dispatch(f'hl.dsp.window.move({{ workspace = "{target}", follow = false, '
                 f'window = "address:{address}" }})')
    return strays


def top_left_entry(entries, addresses):
    """The entry whose tile is top-left — the one that takes a tucked window."""
    live = [i for i in range(len(entries)) if addresses.get(i)]
    if not live:
        return None
    # x + y rather than y, then x: a grouped tile sits lower than its
    # neighbour because of its tab bar, so the top row is not the lowest y.
    return min(live, key=lambda i: (sum((saved_rect(entries[i]) or (0, 0, 0, 0))[:2]), i))


def tuck_window(address, entries, addresses):
    """Put a window into the layout without changing its shape.

    A tab in a group costs no space, so the tile that takes it keeps its
    rectangle and the arrangement is untouched — and the window is still on the
    workspace, one keystroke away, rather than banished. Where the tile is not
    a group (nothing to join), or the merge does not take, the window floats
    over that corner instead, which also keeps it out of the tiling tree.
    Returns what it did, or None.
    """
    index = top_left_entry(entries, addresses)
    if index is None:
        return None
    entry = entries[index]
    anchor = addresses[index]
    merged = False
    if entry.get("group"):
        visible = next((addresses[i] for i, e in enumerate(entries)
                        if e.get("group") == entry["group"] and e.get("group_active")),
                       anchor)
        merged = merge_into_group(anchor, address, entry["workspace"])
        if merged:
            focus_checked(visible)    # the tile keeps showing what it showed
    live = by_address(address)
    if live and workspace_of(live) == SCRATCH:
        # A failed merge must not leave the window parked where nothing looks.
        dispatch(f'hl.dsp.window.move({{ workspace = "{entry["workspace"]}", '
                 f'follow = false, window = "address:{address}" }})')
        time.sleep(0.15)
        merged = False
    if merged:
        return f"as a tab in the {entry['class']} tile"
    rect = saved_rect(entry) or (0, 0, 900, 700)
    dispatch(f'hl.dsp.window.float({{ action = "enable", '
             f'window = "address:{address}" }})')
    dispatch(f'hl.dsp.window.resize({{ x = {rect[2] // 2}, y = {rect[3] // 2}, '
             f'window = "address:{address}" }})')
    dispatch(f'hl.dsp.window.move({{ x = {rect[0] + 40}, y = {rect[1] + 40}, '
             f'window = "address:{address}" }})')
    return f"floating over the corner of the {entry['class']} tile"


def cmd_tuck(args):
    """Fold the focused window into the layout, rather than moving it away."""
    address = active_address()
    client = by_address(address) if address else None
    if client is None:
        sys.exit("hypr-layout: no active window to tuck")
    layout = load_layout(args.file)
    entries = layout["entries"]
    addresses = match_existing(existing_pool(False), entries)
    where = tuck_window(address, entries, addresses)
    if not where:
        sys.exit(f"hypr-layout: could not tuck {client['class']} into the layout")
    print(f"tucked {client['class']} {where}")


def dissolve_solo_groups(entries, addresses):
    """Break up any group holding a single window.

    A group of one is not a group, but it still draws a tab bar — so the window
    sits 28 px down from where it was saved and reports as "unexpectedly
    grouped". Pulling a stray out of one of the layout's tiles leaves exactly
    that behind.
    """
    for i, _e in enumerate(entries):
        address = addresses.get(i)
        client = by_address(address) if address else None
        if not (client and client.get("grouped")):
            continue
        gid = client["grouped"][0]
        members = [c for c in clients()
                   if c.get("grouped") and c["grouped"][0] == gid]
        if len(members) > 1:
            continue
        if focus_checked(address):
            dispatch("hl.dsp.window.move({ out_of_group = true })")
            time.sleep(0.08)


def cmd_spill(args):
    """Send one window to another workspace, to keep a layout clear of strays."""
    workspace = str(args.workspace or SPILL_WORKSPACE)
    address = active_address()
    client = by_address(address) if address else None
    if client is None:
        sys.exit("hypr-layout: no active window to move")
    dispatch(f'hl.dsp.window.move({{ workspace = "{workspace}", follow = false, '
             f'window = "address:{address}" }})')
    print(f"moved {client['class']} to ws{workspace}")


def cmd_layouts(args):
