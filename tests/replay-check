#!/usr/bin/env python3
"""An end-to-end check for hypr-layout, against a live Hyprland session.

Reopening a session is judged by what the compositor ends up with, so this is
the only honest way to check it. The script builds a fixture on a workspace of
its own — a 2x2 of tiles with a group of three tabs in the top-left one — saves
it, kills the windows, brings them back scrambled with two of them not opened
at all (so the replay has to launch them), and replays.

It fails if any window is missing or on the wrong workspace, if a rectangle,
tab order or visible tab does not match the save, if a window that should not
be in a group is in one, or if the replay does not finish promptly. It also
checks that the run trace lands on disk and that a second replay running beside
the first is refused.

It uses its own window class and cleans up after itself, but it does move
windows — run it when you are not mid-something. If it dies half way, close
anything of class `hl-check`.

    python3 tests/replay-check
"""
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
TOOL = os.path.join(os.path.dirname(HERE), "hypr-layout")
FIXTURE = "/tmp/hypr-layout-check.json"
STATE = os.path.expanduser("~/.local/state/hypr-layout")
LOCK = os.path.join(STATE, "replay.lock")
WS, CLS = "10", "hl-check"
TITLES = ("t1", "t2", "t3", "t4", "t5", "t6")

spec = importlib.util.spec_from_loader(
    "hl", importlib.machinery.SourceFileLoader("hl", TOOL))
hl = importlib.util.module_from_spec(spec)
spec.loader.exec_module(hl)
hl.SOCKET_DIR = hl.instance_dir()

results = []


def check(label, ok, detail=""):
    results.append(bool(ok))
    print(f"  [{'PASS' if ok else 'FAIL'}] {label}{(' — ' + str(detail)) if detail else ''}")


def mine():
    return {c["title"]: c for c in hl.clients() if c.get("class") == CLS}


def spawn(title):
    subprocess.Popen(["foot", f"--app-id={CLS}", f"--title={title}", "-e", "sleep", "600"],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wipe():
    for c in hl.clients():
        if c.get("class") == CLS:
            subprocess.run(["kill", str(c["pid"])], capture_output=True)
    time.sleep(0.8)


def run_tool(*args):
    return subprocess.run([sys.executable, TOOL, *args], capture_output=True, text=True)


def entry(title, at, size, group=None, index=0, active=False):
    return {"class": CLS, "title": title, "workspace": WS, "floating": False,
            "at": list(at), "size": list(size),
            "cmd": ["foot", f"--app-id={CLS}", f"--title={title}", "-e", "sleep", "600"],
            "cwd": "/tmp", "group": group, "group_index": index, "group_active": active}


# A tile carrying a tab bar sits 28 px lower and is 28 px shorter than its bare
# neighbour, which is what the compositor will produce — so the fixture uses
# the rectangles a live session actually has, not idealised ones.
TL, TR, BL, BR = (12, 40), (1927, 12), (12, 1066), (1927, 1066)
GROUPED, BARE_TOP, BARE_BOTTOM = (1901, 1012), (1901, 1040), (1901, 1039)
fixture = {"saved_at": "1970-01-01 00:00:00",
           "monitors": [{"name": "DP-1", "mode": "3840x2160@60", "scale": 1}],
           "entries": [entry("t1", TL, GROUPED, "gTL", 0, True),
                       entry("t2", TL, GROUPED, "gTL", 1),
                       entry("t3", TL, GROUPED, "gTL", 2),
                       entry("t4", TR, BARE_TOP),
                       entry("t5", BL, BARE_BOTTOM),
                       entry("t6", BR, BARE_BOTTOM)]}
saved = {e["title"]: e for e in fixture["entries"]}
want_order = ["t1", "t2", "t3"]


def main():
    print("=== stage 1: six windows on ws1, scrambled, t5 and t6 never opened ===")
    wipe()
    json.dump(fixture, open(FIXTURE, "w"), indent=2)
    for title in TITLES[:4]:
        spawn(title)
    time.sleep(2.5)
    for client in mine().values():
        hl.dispatch(f'hl.dsp.window.move({{ workspace = "1", follow = false, '
                    f'window = "address:{client["address"]}" }})')
    time.sleep(0.4)

    started = time.time()
    replay = run_tool("-f", FIXTURE, "restore", "--no-verify")
    elapsed = time.time() - started
    print(replay.stdout.strip())

    windows = mine()
    check("all six windows are back on ws10",
          len(windows) == 6 and all(c["workspace"]["name"] == WS for c in windows.values()),
          sorted((t, c["workspace"]["name"]) for t, c in windows.items()))

    wrong = []
    for title, e in saved.items():
        client = windows.get(title)
        if client is None:
            wrong.append((title, "missing"))
            continue
        if max(abs(client["at"][0] - e["at"][0]), abs(client["at"][1] - e["at"][1]),
               abs(client["size"][0] - e["size"][0]),
               abs(client["size"][1] - e["size"][1])) > 6:
            wrong.append((title, client["at"], client["size"], e["at"], e["size"]))
    check("every window is in its saved rectangle", not wrong, wrong)

    groups = [windows[t].get("grouped") or [] for t in want_order if t in windows]
    grouped = len(groups) == 3 and groups[0] and groups[0] == groups[1] == groups[2]
    check("the top-left three are one group", bool(grouped), groups)
    if grouped:
        order = [next((t for t, c in windows.items() if c["address"] == a), a)
                 for a in groups[0]]
        check("tab order matches the save", order == want_order, f"{order} wanted {want_order}")
        showing = sorted(t for t in want_order if windows[t]["visible"])
        check("the saved tab is the one showing", showing == ["t1"], showing)
    check("t4/t5/t6 are not grouped",
          not any((windows[t].get("grouped") or []) for t in ("t4", "t5", "t6")),
          [windows[t].get("grouped") for t in ("t4", "t5", "t6")])
    check("the replay finished promptly", elapsed < 12, f"{elapsed:.1f}s")
    check("the replay reported every window", "/6 windows placed correctly" in replay.stdout,
          [l for l in replay.stdout.splitlines() if "placed correctly" in l])

    print("\n=== stage 2: the run trace ===")
    trace = run_tool("log").stdout
    check("`hypr-layout log` prints the run", "restore" in trace and "matched entry" in trace,
          f"{len(trace.splitlines())} lines")
    check("the trace shows launched windows being claimed",
          "launched [" in trace and "-> entry" in trace)
    check("the trace shows the recovered tree and the arrangement",
          '"split"' in trace and "preselect" in trace)

    print("\n=== stage 3: one replay at a time ===")
    os.makedirs(STATE, exist_ok=True)
    boot = open("/proc/sys/kernel/random/boot_id").read().strip()
    other = subprocess.Popen(["sleep", "30"])
    open(LOCK, "w").write(f"{other.pid} {boot}")
    refused = run_tool("-f", FIXTURE, "restore")
    check("a replay refuses to start beside another",
          "already running" in refused.stdout + refused.stderr,
          (refused.stdout + refused.stderr).strip().splitlines()[:1])
    open(LOCK, "w").write(f"{other.pid} deadbeef")
    stale = run_tool("-f", FIXTURE, "restore", "--dry-run")
    check("a lock from an earlier boot is stale, not fatal",
          "already running" not in stale.stdout + stale.stderr)
    other.kill()
    if os.path.exists(LOCK):
        os.remove(LOCK)

    print(f"\n{sum(results)}/{len(results)} checks passed")
    return 0 if all(results) else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    finally:
        wipe()
